# Google Cloud OAuth client (Web application).
# Authorized redirect URI on the client must be exactly:
#   https://<your-production-domain>/api/auth/callback/google
# Preview URLs change on every deploy, so do not register them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js session encryption secret. Generate with: npx auth secret
AUTH_SECRET=

# The only account allowed to use the tool. Everything else is rejected.
OWNER_EMAIL=

# Optional. Pin the canonical origin so OAuth runs on the production domain only.
# AUTH_URL=https://your-production-domain
